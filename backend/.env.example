# DecOps backend environment configuration (copy to .env and adjust)
# All variables use the DECOPS_ prefix.

# --- Application ---
DECOPS_ENVIRONMENT=development          # development | testing | staging | production
DECOPS_DEBUG=true
DECOPS_LOG_LEVEL=INFO

# --- Database (PostgreSQL is the production target) ---
# DECOPS_DATABASE_URL=postgresql+psycopg://decops:change-me@localhost:5432/decops
# Local sandbox default: SQLite file in backend/
# DECOPS_DATABASE_URL=sqlite:///decops.db

# --- Sessions ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DECOPS_SESSION_SECRET_KEY=change-me-in-production
DECOPS_SESSION_LIFETIME_MINUTES=720
DECOPS_SECURE_COOKIES=false             # true behind HTTPS in staging/production

# --- Login throttling ---
DECOPS_MAX_FAILED_LOGINS=5
DECOPS_LOGIN_LOCKOUT_MINUTES=15

# --- Seed administrator (change in any real deployment) ---
DECOPS_SEED_ADMIN_EMAIL=admin@interdec.com
DECOPS_SEED_ADMIN_PASSWORD=DecOps!2026
DECOPS_SEED_ADMIN_NAME=Interdec Administrator
DECOPS_SEED_ADMIN_EMPLOYEE_CODE=INT-0001

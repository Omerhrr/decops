# Copy to .env for `docker compose up -d --build` (never commit .env)
DOMAIN=decops.rogan.live
POSTGRES_PASSWORD=            # openssl rand -hex 24
DECOPS_SESSION_SECRET_KEY=    # openssl rand -hex 32
DECOPS_SEED_ADMIN_EMAIL=admin@yourcompany.com
DECOPS_SEED_ADMIN_PASSWORD=   # 12+ chars, change after first login
DECOPS_SEED_DEMO_DATA=false

# --- Optional ---
DECOPS_SENTRY_DSN=                 # error tracking (sentry.io); leave empty to disable
DECOPS_EMAIL_NOTIFICATIONS_ENABLED=false   # true to email reset links + notifications
DECOPS_SMTP_HOST=smtp.example.com
DECOPS_SMTP_PORT=587
DECOPS_SMTP_SSL=false          # true for implicit TLS (port 465)
DECOPS_SMTP_USERNAME=
DECOPS_SMTP_PASSWORD=
DECOPS_EMAIL_FROM=decops@yourcompany.com
BACKUP_HOUR_UTC=2
BACKUP_KEEP_DAYS=14

# Only with docker-compose.shared-caddy.yml: the Docker network of the Caddy that already serves this server
# EDGE_NETWORK=interdec_default
